@using CargoTrack.Entity.Entities
@model Cargo

@{
    ViewData["Title"] = "Kargo Detayları";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-primary-container mb-2">
            Gönderi Detayları
        </h1>

        <p class="text-on-surface-variant font-body-md">
            Gönderinizin güncel durumunu ve bilgilerini inceleyin.
        </p>
    </div>

    <a asp-controller="Default"
       asp-action="Index"
       class="flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold">

        <span class="material-symbols-outlined">search</span>
        Yeni Kargo Sorgula
    </a>
</div>


<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- SOL TARAF -->
    <div class="lg:col-span-8 flex flex-col gap-6">

        <!-- Kargo Ana Bilgileri -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Takip Numarası -->
                <div>
                    <p class="text-sm text-outline mb-1">
                        Takip Numarası
                    </p>

                    <h2 class="font-headline-md text-headline-md text-primary-container">
                        @Model.TrackCode
                    </h2>
                </div>

                <!-- Durum -->
                <div>
                    <p class="text-sm text-outline mb-1">
                        Kargo Durumu
                    </p>

                    <div class="inline-flex items-center gap-2 bg-surface-container-high text-primary-container px-3 py-1 rounded-full font-semibold">

                        <span class="material-symbols-outlined text-[16px]">
                            local_shipping
                        </span>

                        @Model.CargoStatus
                    </div>
                </div>

                <!-- Gönderim Tarihi -->
                <div>
                    <p class="text-sm text-outline mb-1">
                        Gönderim Tarihi
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.ShipmentDate.ToString("dd.MM.yyyy")
                    </p>
                </div>

                <!-- Tahmini Varış -->
                <div>
                    <p class="text-sm text-outline mb-1">
                        Tahmini Varış Tarihi
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.EstinatedArrivalDate.ToString("dd.MM.yyyy")
                    </p>
                </div>

            </div>
        </div>


        <!-- GÜZERGAH -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">

            <h3 class="font-headline-md text-xl text-primary-container mb-6">
                Kargo Güzergahı
            </h3>

            <div class="flex items-center justify-between gap-4">

                <!-- Çıkış -->
                <div class="text-center">

                    <div class="w-10 h-10 mx-auto rounded-full bg-surface-container-high flex items-center justify-center text-primary-container mb-2">
                        <span class="material-symbols-outlined">
                            location_on
                        </span>
                    </div>

                    <p class="font-semibold">
                        @Model.OriginBranch?.Name
                    </p>

                    <p class="text-sm text-outline">
                        Çıkış Şubesi
                    </p>

                </div>


                <!-- Ok -->
                <div class="flex-grow flex items-center">

                    <div class="h-px bg-outline-variant flex-grow"></div>

                    <span class="material-symbols-outlined text-secondary-container mx-3">
                        local_shipping
                    </span>

                    <div class="h-px bg-outline-variant flex-grow"></div>

                </div>


                <!-- Varış -->
                <div class="text-center">

                    <div class="w-10 h-10 mx-auto rounded-full bg-surface-container flex items-center justify-center text-outline mb-2">
                        <span class="material-symbols-outlined">
                            flag
                        </span>
                    </div>

                    <p class="font-semibold">
                        @Model.DestinationBranch?.Name
                    </p>

                    <p class="text-sm text-outline">
                        Varış Şubesi
                    </p>

                </div>

            </div>
        </div>


        <!-- GÖNDERİCİ / ALICI -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Gönderici -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">

                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">
                        person
                    </span>
                </div>

                <div>

                    <p class="text-sm text-outline mb-1">
                        Gönderici
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.Sender
                    </p>

                </div>

            </div>


            <!-- Alıcı -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">

                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">
                        person
                    </span>
                </div>

                <div>

                    <p class="text-sm text-outline mb-1">
                        Alıcı
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.Receiver
                    </p>

                </div>

            </div>

        </div>


        <!-- KARGO BİLGİLERİ -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">

            <h3 class="font-headline-md text-xl text-primary-container mb-4">
                Kargo Bilgileri
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                <!-- Kargo Tipi -->
                <div class="bg-surface rounded-lg p-4">

                    <p class="text-sm text-outline mb-1">
                        Kargo Tipi
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.cargoType
                    </p>

                </div>


                <!-- Çıkış Şubesi -->
                <div class="bg-surface rounded-lg p-4">

                    <p class="text-sm text-outline mb-1">
                        Çıkış Şubesi
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.OriginBranch?.Name
                    </p>

                </div>


                <!-- Varış Şubesi -->
                <div class="bg-surface rounded-lg p-4">

                    <p class="text-sm text-outline mb-1">
                        Varış Şubesi
                    </p>

                    <p class="font-semibold text-on-background">
                        @Model.DestinationBranch?.Name
                    </p>

                </div>

            </div>
        </div>


        <!-- TAHMİNİ TESLİMAT -->
        <div class="bg-primary-container rounded-xl shadow-sm p-6 text-on-primary">

            <div class="flex items-center gap-3 mb-2">

                <span class="material-symbols-outlined text-[28px]">
                    schedule
                </span>

                <h3 class="font-headline-md text-2xl font-bold">
                    Tahmini Teslimat
                </h3>

            </div>

            <p class="text-primary-fixed-dim ml-10">
                @Model.EstinatedArrivalDate.ToString("dd.MM.yyyy")
            </p>

        </div>

    </div>


    <!-- SAĞ TARAF -->
    <div class="lg:col-span-4">

        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">

            <div class="flex items-center gap-2 mb-6 pb-4 border-b border-outline-variant/30">

                <span class="material-symbols-outlined text-primary-container">
                    info
                </span>

                <h3 class="font-headline-md text-xl text-primary-container">
                    Gönderi Özeti
                </h3>

            </div>


            <div class="space-y-5">

                <div>
                    <p class="text-sm text-outline">
                        Takip Kodu
                    </p>

                    <p class="font-semibold">
                        @Model.TrackCode
                    </p>
                </div>


                <div>
                    <p class="text-sm text-outline">
                        Durum
                    </p>

                    <p class="font-semibold">
                        @Model.CargoStatus
                    </p>
                </div>


                <div>
                    <p class="text-sm text-outline">
                        Kargo Tipi
                    </p>

                    <p class="font-semibold">
                        @Model.cargoType
                    </p>
                </div>


                <div>
                    <p class="text-sm text-outline">
                        Gönderim
                    </p>

                    <p class="font-semibold">
                        @Model.ShipmentDate.ToString("dd.MM.yyyy")
                    </p>
                </div>


                <div>
                    <p class="text-sm text-outline">
                        Tahmini Varış
                    </p>

                    <p class="font-semibold">
                        @Model.EstinatedArrivalDate.ToString("dd.MM.yyyy")
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>