@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h3>Şubelerimiz</h3>

<table class="table table-bordered table-hover">
    @{
        int count = 0;
    }

    <tr>
        <th>#</th>
        <th>Şube İsmi</th>
        <th>Şehir</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Name</td>
            <td>@item.City.Name</td>
            <td>
                <form asp-area="Admin"
                      asp-controller="Branch"
                      asp-action="Delete"
                      asp-route-id="@item.Id"
                      method="post"
                      style="display:inline;">

                    <button type="submit"
                            onclick="return confirm('Silmek istediğinize emin misiniz?')"
                            class="btn btn-danger">
                        Sil
                    </button>

                </form>                <a href="/Admin/Branch/Update/@item.Id" class="btn btn-info">Güncelle</a>

            </td>
        </tr>
    }

</table>

<a href="/Admin/Branch/Create" class="btn btn-dark">Yeni Şube Oluştur</a>